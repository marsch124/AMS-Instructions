DEFINE SCHEMA

    RECORD TYPE CD_Instruction (
        "___createTime"              TIMESTAMP,
        "___createdBy"               REFERENCE,
        "___etag"                    STRING,
        "___modTime"                 TIMESTAMP,
        "___modifiedBy"              REFERENCE,
        "___recordID"                REFERENCE QUERYABLE,
        CD_entityName                STRING,
        CD_uid                       STRING,
        CD_number                    STRING,
        CD_title                     STRING,
        CD_category                  STRING,
        CD_location                  STRING,
        CD_locationDetail            STRING,
        CD_summary                   STRING,
        CD_owner                     STRING,
        CD_ownerID                   STRING,
        CD_status                    STRING,
        CD_frequency                 STRING,
        CD_timeEstimate              INT64,
        CD_difficulty                INT64,
        CD_tags                      BYTES,
        CD_tags_ckAsset              ASSET,
        CD_warnings                  STRING,
        CD_equipment                 STRING,
        CD_preparations              STRING,
        CD_steps                     BYTES,
        CD_steps_ckAsset             ASSET,
        CD_afterUse                  STRING,
        CD_maintenance               STRING,
        CD_notes                     STRING,
        CD_related                   BYTES,
        CD_related_ckAsset           ASSET,
        CD_completionCount           INT64,
        CD_lastCompleted             TIMESTAMP,
        CD_createdAt                 TIMESTAMP,
        CD_isFavorite                INT64,
        CD_lastViewedAt              TIMESTAMP,
        CD_linksData                 BYTES,
        CD_linksData_ckAsset         ASSET,
        CD_revisionsData             BYTES,
        CD_revisionsData_ckAsset     ASSET,
        CD_completionLogData         BYTES,
        CD_completionLogData_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_InstructionPhoto (
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        CD_entityName        STRING,
        CD_uid               STRING,
        CD_instructionUID    STRING,
        CD_name              STRING,
        CD_imageData         BYTES,
        CD_imageData_ckAsset ASSET,
        CD_thumbData         BYTES,
        CD_thumbData_ckAsset ASSET,
        CD_width             INT64,
        CD_height            INT64,
        CD_originalSize      INT64,
        CD_step              INT64,
        CD_sortIndex         INT64,
        CD_addedAt           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Person (
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        CD_entityName          STRING,
        CD_uid                 STRING,
        CD_name                STRING,
        CD_phone               STRING,
        CD_email               STRING,
        CD_handlesData         BYTES,
        CD_handlesData_ckAsset ASSET,
        CD_createdAt           TIMESTAMP,
        CD_updatedAt           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Audit (
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        CD_entityName          STRING,
        CD_uid                 STRING,
        CD_instructionUID      STRING,
        CD_instructionNumber   STRING,
        CD_auditorID           STRING,
        CD_auditorName         STRING,
        CD_timestamp           TIMESTAMP,
        CD_findings            STRING,
        CD_convertedToActionID STRING,
        CD_createdAt           TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ActionItem (
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        CD_entityName        STRING,
        CD_uid               STRING,
        CD_title             STRING,
        CD_notes             STRING,
        CD_priority          STRING,
        CD_dueDate           STRING,
        CD_status            STRING,
        CD_instructionUID    STRING,
        CD_instructionNumber STRING,
        CD_sourceAuditID     STRING,
        CD_createdAt         TIMESTAMP,
        CD_completedAt       TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
